{
    "name": "uhc-functions",
    "description": "Cloud Functions for UHC",
    "scripts": {
        "build": "tsc",
        "test": "npm run build && node test/admin_deletion.test.js",
        "serve": "npm run build && firebase emulators:start --only functions",
        "shell": "npm run build && firebase functions:shell",
        "start": "npm run shell",
        "deploy": "firebase deploy --only functions",
        "logs": "firebase functions:log"
    },
    "engines": {
        "node": ">=18"
    },
    "main": "lib/index.js",
    "dependencies": {
        "firebase-admin": "^13.10.0",
        "firebase-functions": "^6.0.0"
    },
    "devDependencies": {
        "typescript": "^5.0.0"
    },
    "private": true
}
